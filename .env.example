# MANTIS x PayPal gate. Copy to .env (gitignored) and fill in for live mode.
# Mock mode needs NONE of this: `make gate-demo` runs from a clean clone.

# mock (default): replay recorded PayPal responses, no keys, no network.
# live (alias: sandbox): the PayPal SANDBOX. There is no setting for production.
MANTIS_PAYPAL_MODE=mock

# Sandbox app credentials: developer.paypal.com -> Apps & Credentials -> Sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Optional. HMAC key for mandate signatures; defaults to a named demo key.
# MANTIS_MANDATE_KEY=

# Optional. Only used when the sandbox app has Advanced Card Payments enabled;
# otherwise the gate uses PayPal Vault (python -m mantis.paypal vault-setup).
# MANTIS_PAYPAL_TEST_CARD=4111111111111111
